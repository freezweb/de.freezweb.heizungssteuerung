[Unit]
Description=Heizungssteuerung Freezweb Keller-Slave (Modbus TCP I/O)
After=network-online.target piControl.service
Wants=network-online.target piControl.service
Conflicts=heizung.service revpipyload.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=heizung
Group=heizung
SupplementaryGroups=picontrol
WorkingDirectory=/opt/heizung
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/heizung/.venv/bin/python -m heizung.keller_slave
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/heizung/state /var/log

[Install]
WantedBy=multi-user.target
