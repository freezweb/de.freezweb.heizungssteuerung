(kicad_sch
  (version 20240108)
  (generator "codex")
  (uuid "d5e42fe8-0c45-43b8-a242-42b955d18b37")
  (paper "A3")
  (title_block
    (title "RS485-Pumpengruppen-Platine")
    (date "2026-06-25")
    (rev "A-preliminary")
    (company "Freezweb")
    (comment 1 "230 V AC + SELV getrennt; vor Fertigung elektrisch pruefen")
    (comment 2 "ESP32 Modbus-RTU-Slave, OTA per WLAN, lokale Mischer-Laufzeitlogik")
  )
  (lib_symbols)
  (text "230 V AC / MAINS ZONE\n- X1: Einspeisung L/N/PE\n- F1: Board-/Lastsicherung nach Pumpenrating\n- K1: Pumpe L geschaltet\n- K2/K3: Mischer AUF/ZU, hardwareseitig verriegelt\n- PE bevorzugt als externe/kurze Schutzleiterbruecke dimensionieren" (at 25 20 0)
    (effects (font (size 2 2)) (justify left top))
    (uuid "14b4d224-1371-4d9d-84e7-d20d4a3b3b1e")
  )
  (text "SELV / CONTROL ZONE\n- U1: ESP32-WROOM-32U, Antenne extern ueber U.FL\n- X6/U6: USB-C Service + USB-UART fuer Firmware/Debug\n- U2/U3: MAX31865 RTD VL/RL\n- U4: isolierter RS485\n- J1/J2 RJ45 + J3/J4 Schraubklemmen liegen parallel\n- WLAN nur Konfiguration/OTA, Regelbetrieb ueber Modbus RTU" (at 150 20 0)
    (effects (font (size 2 2)) (justify left top))
    (uuid "704b4b41-f36c-4e98-b69e-c110d3551a47")
  )
  (text "Isolationsgrenze im PCB: mindestens 8 mm zwischen MAINS und SELV, Fraesnut/Keepout im Layout." (at 95 185 0)
    (effects (font (size 2 2)))
    (uuid "f5d076b4-7674-4bd6-b8ed-bd7b8eac7b89")
  )
  (text "NETZ-/LASTLOGIK\nX1.1 L_IN -> F1 -> L_FUSED\nX1.2 N -> X2.2, X3.3, PSU1.N\nX1.3 PE -> X2.3, X3.4\nK1: L_FUSED -> L_PUMP -> X2.1\nK2: L_FUSED -> L_OPEN -> X3.1\nK3: L_FUSED -> L_CLOSE -> X3.2\nK2/K3 zusaetzlich per Firmware und Treiber verriegeln." (at 25 155 0)
    (effects (font (size 1.6 1.6)) (justify left top))
    (uuid "b89b61a1-442f-4f4f-9087-94b17e1d8fc2")
  )
  (text "SELV-/MCU-LOGIK\nPSU1 5V -> U5 -> 3V3\nU1 ESP32-WROOM-32U: externe Antenne per U.FL\nU1 GPIO -> Relaistreiber: PUMP_DRV, OPEN_DRV, CLOSE_DRV\nU2/U3 MAX31865: SPI_MOSI, SPI_MISO, SPI_SCK\nX4 RTD_VL_P/N, X5 RTD_RL_P/N" (at 95 155 0)
    (effects (font (size 1.6 1.6)) (justify left top))
    (uuid "1c03e38e-8289-4940-91c7-0e662461eaf4")
  )
  (text "BUS / SERVICE\nU4 isolierter RS485: A=RS485_A, B=RS485_B, COM=RS485_GND\nJ1/J2 RJ45 parallel: Pin 4=D+, Pin 5=D-, Pin 7/8=COM\nJ3/J4 YSTY parallel: D+, D-, COM\nR3 120R + JP1: schaltbarer Abschluss zwischen A und B\nX6 USB-C -> U6 USB-UART -> U1 UART_TX/RX; CC1/CC2 je 5k1 nach GND" (at 165 155 0)
    (effects (font (size 1.6 1.6)) (justify left top))
    (uuid "a1d1210a-d0c7-40d2-982f-94ec7c11ec49")
  )
