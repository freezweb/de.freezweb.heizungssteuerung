# Modbus-Register-Definitionen
#
# Pro Modbus-Bus und Slave die relevanten Register-Adressen.
# Wird beim Geraete-Setup pro Hersteller-Datasheet ausgefuellt.

busse:
  bus_wp:
    interface: "tcp"            # via Waveshare RS485-zu-Ethernet
    host: "10.1.25.50"          # IP des Waveshare-Gateways (TBD)
    port: 502
    rtu_baud: 9600
    rtu_parity: "N"
    rtu_stopbits: 1
    timeout_s: 2

  bus_bwwp_aux:
    interface: "tcp"
    host: "10.1.25.51"
    port: 502
    rtu_baud: 9600
    rtu_parity: "N"
    rtu_stopbits: 1
    timeout_s: 2

  bus_klima_og:
    interface: "tcp"
    host: "10.1.25.52"          # Anschluss am Slave-Schrank (spaeter)
    port: 502
    rtu_baud: 9600
    rtu_parity: "N"
    rtu_stopbits: 1
    timeout_s: 2

slaves:
  wp1:
    bus: "bus_wp"
    address: 1
    register:
      vl_soll:      { typ: "holding", addr: 100, datatype: "uint16", scale: 0.1, einheit: "C", rw: "rw" }
      vl_ist:       { typ: "input",   addr: 200, datatype: "int16",  scale: 0.1, einheit: "C", rw: "r" }
      rl_ist:       { typ: "input",   addr: 201, datatype: "int16",  scale: 0.1, einheit: "C", rw: "r" }
      modus:        { typ: "holding", addr: 110, datatype: "uint16", scale: 1,   einheit: "enum:0=aus,1=heizen,2=kuehlen,3=ww", rw: "rw" }
      leistung_pct: { typ: "input",   addr: 210, datatype: "uint16", scale: 1,   einheit: "%", rw: "r" }
      stoerung:     { typ: "input",   addr: 220, datatype: "uint16", scale: 1,   einheit: "bitfield", rw: "r" }

  wp2:
    bus: "bus_wp"
    address: 2
    register:
      # Identisch zu wp1 - sobald WP-Modell feststeht ggf. anpassen
      vl_soll:      { typ: "holding", addr: 100, datatype: "uint16", scale: 0.1, einheit: "C", rw: "rw" }
      vl_ist:       { typ: "input",   addr: 200, datatype: "int16",  scale: 0.1, einheit: "C", rw: "r" }
      rl_ist:       { typ: "input",   addr: 201, datatype: "int16",  scale: 0.1, einheit: "C", rw: "r" }
      modus:        { typ: "holding", addr: 110, datatype: "uint16", scale: 1,   einheit: "enum", rw: "rw" }
      leistung_pct: { typ: "input",   addr: 210, datatype: "uint16", scale: 1,   einheit: "%", rw: "r" }
      stoerung:     { typ: "input",   addr: 220, datatype: "uint16", scale: 1,   einheit: "bitfield", rw: "r" }

  bwwp:
    bus: "bus_bwwp_aux"
    address: 10
    register:
      vl_soll:      { typ: "holding", addr: 100, datatype: "uint16", scale: 0.1, einheit: "C", rw: "rw" }
      vl_ist:       { typ: "input",   addr: 200, datatype: "int16",  scale: 0.1, einheit: "C", rw: "r" }
      modus:        { typ: "holding", addr: 110, datatype: "uint16", scale: 1,   einheit: "enum", rw: "rw" }

  pool_peripherie:
    bus: "bus_bwwp_aux"
    address: 11
    register:
      # Optionaler Pool-/Filtercontroller. Waerme kommt aus dem Gesamtwaermekreis,
      # nicht aus einer eigenen Pool-WP.
      wasser_temp:  { typ: "input",   addr: 200, datatype: "int16",  scale: 0.1, einheit: "C", rw: "r" }
      filter_pct:   { typ: "holding", addr: 100, datatype: "uint16", scale: 1,   einheit: "%", rw: "rw" }

  # Inter-CPU: Slave-RevPi exponiert seine I/O als Modbus-TCP Server
  slave_revpi:
    bus: "bus_keller"           # ueber LAN/VLAN 25 direkt
    address: 1
    host: "10.1.25.11"
    port: 502
    register:
      # Holding Register: Hauptsteuerung -> Keller-Slave
      command_counter: { typ: "holding", addr: 0, datatype: "uint16", scale: 1, rw: "w" }
      enable:          { typ: "holding", addr: 1, datatype: "uint16", scale: 1, rw: "w" }
      do_bitmask:      { typ: "holding", addr: 10, datatype: "uint16", scale: 1, rw: "w", einheit: "bit0=K-DO01" }
      ao01_pct_x10:    { typ: "holding", addr: 20, datatype: "uint16", scale: 0.1, rw: "w" }
      ao02_pct_x10:    { typ: "holding", addr: 21, datatype: "uint16", scale: 0.1, rw: "w" }
      ao03_pct_x10:    { typ: "holding", addr: 22, datatype: "uint16", scale: 0.1, rw: "w" }
      ao04_pct_x10:    { typ: "holding", addr: 23, datatype: "uint16", scale: 0.1, rw: "w" }

      # Input Register: Keller-Slave -> Hauptsteuerung
      status:          { typ: "input", addr: 0, datatype: "uint16", scale: 1, rw: "r", einheit: "bit0=ready,bit1=master_fresh,bit2=io_ok" }
      last_command:    { typ: "input", addr: 1, datatype: "uint16", scale: 1, rw: "r" }
      do_feedback:     { typ: "input", addr: 10, datatype: "uint16", scale: 1, rw: "r" }
      ao_feedback_1:   { typ: "input", addr: 20, datatype: "uint16", scale: 0.1, rw: "r" }
      ai01_x100:       { typ: "input", addr: 100, datatype: "int16", scale: 0.01, rw: "r", einheit: "bar" }
      rtd01_x10:       { typ: "input", addr: 120, datatype: "int16", scale: 0.1, rw: "r", einheit: "C" }
