# Globale Einstellungen Heizungssteuerung

regelung:
  zyklus_ms: 1000               # Hauptregelkreis-Zyklus
  mischer_reserve_k: 5           # Aufschlag auf WP-VL gegenueber hoechster Mischer-Anforderung
  oelbrenner_unterstuetzung: true # Phase A: alter Kessel darf gemeinsame Waermeanforderung bedienen

regler:
  # Live geaenderte Reglerparameter aus HA werden hier persistiert.
  state_persist_path: "state/regler.json"

hydraulik:
  # Alle diese Anforderungen haengen am gemeinsamen Gesamtwaermekreis.
  # Beide Haupt-WPs speisen diesen Kreis; Pool/Nebengebaeude/Haus sind Senken.
  common_heat_demands: [fbh_eg, klima_og, nebengeb, pool, hk_backup]

freigaben:
  # Persistente Live-Aenderungen landen in state/freigaben.json.
  # Startzustand: Oelbrenner darf den Bestand weiter versorgen; WPs werden erst
  # nach Einbau/Freigabe in HA in die Sequenz aufgenommen.
  state_persist_path: "state/freigaben.json"
  quellen:
    oelbrenner: true
    wp1: false
    wp2: false
    bwwp: false
  senken:
    brauchwasser: true
    fbh_eg: true
    klima_og: false
    nebengeb: false
    hk_backup: false
    pool: false

anforderungen:
  fbh_eg: { aktiv: false, vl_soll: 35, quelle: default }
  klima_og: { aktiv: false, vl_soll: 18, quelle: default }
  nebengeb: { aktiv: false, vl_soll: 38, quelle: default }
  hk_backup: { aktiv: false, vl_soll: 50, quelle: default }
  pool: { aktiv: false, vl_soll: 38, quelle: default }
  bwwp: { aktiv: false, vl_soll: 50, quelle: default }

brauchwasser:
  # Aktuelle Bestands-Brauchwasserbereitung ueber Oelbrenner + Ladepumpe.
  # Abschaltbar ueber Freigabe Senke "brauchwasser" in HA.
  soll_c: 50
  hysterese_k: 5
  sensor_min_c: -20
  sensor_max_c: 95

heizkurve:
  # Stuetzpunkte (Aussentemperatur -> VL-Soll); HA kann diese ueberschreiben
  stuetzpunkte:
    - { aussen: -12, vl: 45 }
    - { aussen:   0, vl: 38 }
    - { aussen: +15, vl: 25 }
  vl_min: 25
  vl_max: 55

wp:
  # Wechselrhythmus zwischen WP1/WP2 fuer gleichmaessige Laufzeit
  wechsel_stunden: 24
  # Wann beide WPs gleichzeitig laufen sollen (in % der max. Leistung)
  parallel_ab_pct: 50
  # Solange keine echte Leistungsanforderung vorliegt: ab so vielen aktiven Senken beide WPs freigeben.
  parallel_ab_aktive_kreise: 2
  bwwp:
    soll_normal: 50
    soll_legionellen: 65
    legionellen_intervall_tage: 7

pool:
  soll_winter: 35
  soll_sommer: 28
  max_pv_ueberschuss_temp: 40
  becken_volumen_m3: 30
  filter_speed_pct: 100

failsafe:
  mqtt_timeout_s: 60
  ha_heartbeat_timeout_s: 300
  # Inbetriebnahme: HA-Heartbeat und Aussenfuehler noch nicht als harte
  # Failsafe-Bedingung verwenden, sonst zieht der Bestandskessel sofort an.
  mqtt_activity_required: false
  ha_heartbeat_required: false
  outside_sensor_required: false
  fallback_vl_ohne_aussenfuehler: 50
  pumpen_an_im_failsafe: true

hand:
  # Default-Hand-Timeout (kann pro Kanal in io_map.yaml ueberschrieben werden)
  default_timeout_min: null     # null = nie automatisch zurueck
  state_persist_path: "state/hand_state.json"

logging:
  level: INFO
  datei: "/var/log/heizung.log"
  rotate_mb: 10
  keep: 5
