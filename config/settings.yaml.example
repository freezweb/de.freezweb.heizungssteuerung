# Globale Einstellungen Heizungssteuerung

regelung:
  fast_zyklus_ms: 100            # schneller I/O-/Brunnen-Zyklus
  heizung_divider: 10            # Heizungsrouting/Brauchwasser/MQTT nur jeden 10. schnellen Zyklus
  mischer_reserve_k: 5           # Aufschlag auf WP-VL gegenueber hoechster Mischer-Anforderung
  oelbrenner_unterstuetzung: true # Phase A: alter Kessel darf gemeinsame Waermeanforderung bedienen
  oelbrenner_hysterese_k: 1      # Brenner fuer Gesamtwaerme startet erst unter VL-Soll minus Hysterese

leds:
  enabled: true
  peer_timeout_s: 90
  heartbeat_interval_s: 1.0
  # CPU-eigene LEDs RevPi Connect 4:
  # A1: Heartbeat, wechselt alle heartbeat_interval_s blau/gelb
  # A2: Verbindung zur anderen CPU (gruen=ok, gelb=Start/Warten, rot=kein Heartbeat)
  # Hauptsteuerung zusaetzlich:
  # A3: MQTT Broker; bei aktivem keller_relais: R421B16 Modbus-Verbindung
  # A4: HA-Heartbeat
  # A5: bei aktivem pool_prodino dessen Modbus-Verbindung, sonst Failsafe
  # Kellersteuerung: A3-A5 bleiben aus

intercpu:
  keller:
    # Aktiv lassen, solange Brunnen-Drucksensor/FU und weitere Keller-AI/AO/RTD
    # auf dem Keller-RevPi liegen. Das R421B16 unter keller_relais ersetzt nur
    # die drei Heizkreis-Pumpen/Mischer-Ausgaenge.
    enabled: true
    host: "10.1.25.11"
    port: 502
    timeout_s: 1.0
  keller_slave:
    host: "0.0.0.0"
    port: 502
    zyklus_ms: 100
    watchdog_s: 5

keller_relais:
  # Waveshare RS485-zu-TCP im TCP-Server-Modus: hier laufen rohe Modbus-RTU-
  # Frames ueber TCP-Port 26, kein Modbus TCP/MBAP.
  enabled: false
  host: "10.1.100.169"
  port: 26
  unit_id: 1
  protocol: "modbus_tcp"   # Waveshare Socket A: TCP Server + ModbusTCP
  timeout_s: 0.5
  command_delay_s: 0.03
  health_poll_interval_s: 5.0
  state_persist_path: "state/keller_relais.json"
  runtime_s: 120
  tolerance_pct: 1.0
  test_mode:
    enabled: false
    pump_on: true
    target_pct: 100
  groups:
    fbh_eg:
      pump_component: "pumpe_fbh_eg"
      mixer_component: "mischer_fbh_eg_pct"
      vl_component: "fbh_eg_vl"
      target_channel_id: "K-AO02"                         # interner Prozent-Sollwert aus dem Routing, keine Hardware-AO
      relays: { pump: 1, enable: 2, direction: 3 }   # R3: aus=NC/Zu, an=NO/Auf
    hk_backup:
      pump_component: "pumpe_hk_backup"
      mixer_component: "mischer_hk_backup_pct"
      vl_component: "hk_backup_vl"
      target_channel_id: "K-AO04"                         # interner Prozent-Sollwert aus dem Routing, keine Hardware-AO
      relays: { pump: 4, enable: 5, direction: 6 }   # R6: aus=NC/Zu, an=NO/Auf
    klima_og:
      pump_component: "pumpe_klima_og"
      mixer_component: "mischer_klima_og_pct"
      vl_component: "klima_og_vl"
      target_channel_id: "K-AO03"                         # interner Prozent-Sollwert aus dem Routing, keine Hardware-AO
      relays: { pump: 7, enable: 8, direction: 9 }   # R9: aus=NC/Zu, an=NO/Auf

regler:
  # Live geaenderte Reglerparameter aus HA werden hier persistiert.
  state_persist_path: "state/regler.json"

hydraulik:
  # Alle diese Anforderungen haengen am gemeinsamen Gesamtwaermekreis.
  # Beide Haupt-WPs speisen diesen Kreis; Pool/Nebengebaeude/Haus sind Senken.
  common_heat_demands: [fbh_eg, klima_og, nebengeb, pool, hk_backup]

pumpengruppen:
  nebengeb:
    enabled: true
    host: "10.1.20.189"
    port: 502
    unit_id: 30
    timeout_s: 0.5
    poll_interval_s: 1.0
    pump_component: "pumpe_nebengeb"
    mixer_component: "sv_nebengeb_pct"
    vl_component: "vl_nebengeb"
    rl_component: "rl_nebengeb"
    # Solange die Pumpengruppe aktiv ist, werden DO14/DO15/DO18/AO04 nicht
    # physisch am RevPi geschrieben, sondern nur logisch berechnet und per
    # Modbus TCP an das ESP-Board uebertragen.
    disable_local_outputs: true

pool_prodino:
  enabled: false
  protocol: "modbus_tcp"
  host: "10.1.1.146"
  port: 502
  unit_id: 1
  timeout_s: 0.5
  poll_interval_s: 1.0
  # Nur fuer Alt-/Testfirmware mit MQTT. Im Livebetrieb nutzt der Prodino Modbus TCP.
  topic_base: "heizung/prodino_pool"
  input_index: 1
  # Prodino OptoIn ist hier aktiv-low: 0 bedeutet Pool zu leer.
  float_empty_high: false
  valve_component: "pool_nachfuellventil"
  pump_component: "pool_flockung_pumpe"
  float_component: "pool_schwimmer_zu_leer"
  state_persist_path: "state/pool_nachspeisung.json"
  health_timeout_s: 90

pool_nachspeisung:
  # Testmodus: leerer Schwimmer startet nach delay_s unabhaengig von 02:00.
  # Im Livebetrieb auf 0 setzen, dann wird nur zur start_hour nachgespeist.
  testmodus: 1
  start_hour: 2
  delay_s: 30
  max_fill_s: 3600

pool_flockung:
  # Kontinuierliche Zugabe: 20 ml / 10 m3 bei 18 m3 Pool = 36 ml/Tag.
  tagesdosis_ml: 36
  start_hour: 2
  # Stark eisenhaltiges Nachfuellwasser: 1 ml / 10 l = 0,1 ml/l.
  ml_pro_l_frischwasser: 0.1
  # Kalibriert: 1 l in 7 min 30 s = 133,33 ml/min.
  pumpe_ml_min: 133.33

mischer:
  fbh_eg:
    hysterese_k: 0.3
    kp_pct_pro_k: 8.0
    max_step_pct: 5.0
    max_open_step_pct: 2.0
    max_close_step_pct: 5.0
    control_interval_s: 30.0
    anticipation_s: 90.0
    min_pct: 0
    max_pct: 100
  hk_backup:
    hysterese_k: 0.3
    kp_pct_pro_k: 8.0
    max_step_pct: 5.0
    max_open_step_pct: 2.0
    max_close_step_pct: 5.0
    control_interval_s: 30.0
    anticipation_s: 90.0
    min_pct: 0
    max_pct: 100
  klima_og:
    hysterese_k: 0.3
    kp_pct_pro_k: 8.0
    max_step_pct: 5.0
    max_open_step_pct: 2.0
    max_close_step_pct: 5.0
    control_interval_s: 30.0
    anticipation_s: 90.0
    min_pct: 0
    max_pct: 100
  nebengeb:
    hysterese_k: 0.3
    kp_pct_pro_k: 8.0
    max_step_pct: 20.0
    min_pct: 0
    max_pct: 100

freigaben:
  # Persistente Live-Aenderungen landen in state/freigaben.json.
  # Startzustand: Oelbrenner darf den Bestand weiter versorgen; WPs werden erst
  # nach Einbau/Freigabe in HA in die Sequenz aufgenommen.
  state_persist_path: "state/freigaben.json"
  quellen:
    oelbrenner: true
    wp1: false
    wp2: false
    bwwp: false
  senken:
    brauchwasser: true
    fbh_eg: true
    klima_og: false
    nebengeb: false
    hk_backup: false
    pool: false

anforderungen:
  fbh_eg: { aktiv: false, vl_soll: 35, quelle: default }
  klima_og: { aktiv: false, vl_soll: 18, quelle: default }
  nebengeb: { aktiv: false, vl_soll: 38, quelle: default }
  hk_backup: { aktiv: false, vl_soll: 50, quelle: default }
  pool: { aktiv: false, vl_soll: 38, quelle: default }
  bwwp: { aktiv: false, vl_soll: 50, quelle: default }

brauchwasser:
  # Aktuelle Bestands-Brauchwasserbereitung ueber Oelbrenner + Ladepumpe.
  # Abschaltbar ueber Freigabe Senke "brauchwasser" in HA.
  soll_c: 50
  hysterese_k: 5
  sensor_min_c: -20
  sensor_max_c: 95

brunnen:
  # Konstantdruckregelung fuer die Brunnenpumpe am FU.
  # Physisch sitzt die Pumpe im Keller; die realen Kanäle gehoeren daher auf den Keller-RevPi:
  # - AI:  brunnen_druck (4-20 mA, 0-10 bar)
  # - AO:  brunnen_fu_soll (4-20 mA zum FU; FU ist so skaliert, dass 0% = Stop)
  # - DO:  brunnen_pumpe_freigabe (optionale zusaetzliche FU-Run/Freigabe)
  min_druck_bar: 2.2      # Unterschreiten -> Pumpe startet
  max_druck_bar: 4.2      # Ueberschreiten -> Pumpe stoppt (kein Abnehmer offen)
  regeldruck_bar: 3.2     # Konstantdruck waehrend ein Abnehmer offen ist
  druck_sensor_signal: "4-20ma" # 0 mA / Rohwert 0 = Leitungsbruch/nicht angeschlossen
  druck_sensor_bereich_bar: 10.0
  druck_sensor_min_ma: 4.0
  druck_sensor_max_ma: 20.0
  druck_sensor_min_ma_toleranz: 0.2
  druck_sensor_min_bar: -0.2
  druck_sensor_max_bar: 10.5
  fu_min_pct: 0
  fu_max_pct: 100
  fu_start_pct: 20
  kp_pct_pro_bar: 25
  fu_ramp_up_pct_s: 25     # starke Pumpe: langsam hoch, ca. 4 s von 0 -> 100%
  fu_ramp_down_pct_s: 500  # bei schliessendem Hahn sehr schnell Druckspitzen abfangen
  flow_min_l_min: 0.2      # darunter gilt der Flowmeter als "kein Wasserverbrauch"
  flow_timeout_s: 120      # so lange kein Flow -> Brunnenpumpe stoppen
  flow_stop_regeldruck_tolerance_bar: 0.2 # Flow-Timer erst ab Regeldruck minus Toleranz
  flow_stale_timeout_s: 15 # wenn Modbuswert aelter ist, wird er ignoriert
  flow_modbus:
    enabled: true
    host: wasserverbrauch-pumpe.local
    port: 502
    unit_id: 1
    register_type: input
    register: 0
    scale: 100             # Registerwert = L/min * 100
    timeout_s: 0.3
    poll_interval_s: 1.0

klima_og:
  # Kuehlbetrieb ueber Brunnen/Waermetauscher ist absichtlich aus, bis Ventil
  # und Hydraulik fertig verdrahtet sind. Aktivieren, wenn der Kuehlstrang
  # gefahrlos oeffnen darf.
  kuehlung_enabled: false
  kuehlung_max_vl_soll_c: 25
  kuehlung_hysterese_k: 1

heizkurve:
  # Stuetzpunkte (Aussentemperatur -> VL-Soll); HA kann diese ueberschreiben
  stuetzpunkte:
    - { aussen: -12, vl: 45 }
    - { aussen:   0, vl: 38 }
    - { aussen: +15, vl: 25 }
  vl_min: 25
  vl_max: 55

wp:
  # Wechselrhythmus zwischen WP1/WP2 fuer gleichmaessige Laufzeit
  wechsel_stunden: 24
  # Wann beide WPs gleichzeitig laufen sollen (in % der max. Leistung)
  parallel_ab_pct: 50
  # Solange keine echte Leistungsanforderung vorliegt: ab so vielen aktiven Senken beide WPs freigeben.
  parallel_ab_aktive_kreise: 2
  bwwp:
    soll_normal: 50
    soll_legionellen: 65
    legionellen_intervall_tage: 7

pool:
  soll_winter: 35
  soll_sommer: 28
  max_pv_ueberschuss_temp: 40
  becken_volumen_m3: 30
  filter_speed_pct: 100

failsafe:
  mqtt_timeout_s: 60
  ha_heartbeat_timeout_s: 300
  # Inbetriebnahme: HA-Heartbeat und Aussenfuehler noch nicht als harte
  # Failsafe-Bedingung verwenden, sonst zieht der Bestandskessel sofort an.
  mqtt_activity_required: false
  ha_heartbeat_required: false
  outside_sensor_required: false
  fallback_vl_ohne_aussenfuehler: 50
  pumpen_an_im_failsafe: true

hand:
  # Default-Hand-Timeout (kann pro Kanal in io_map.yaml ueberschrieben werden)
  default_timeout_min: null     # null = nie automatisch zurueck
  state_persist_path: "state/hand_state.json"

logging:
  level: INFO
  datei: "/var/log/heizung.log"
  rotate_mb: 10
  keep: 5
